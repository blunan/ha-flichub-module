{
	"private": true,
	"license": "MIT",
	"version": "1.3.0",
	"name": "flic-hub-home-assistant-module",
	"description": "Flic Hub Module for Home Assistant",
	"author": "Brayan Luna <blun4n@gmail.com> (https://www.blunan.com)",
	"scripts": {
		"test": "jest",
		"lint": "eslint .",
		"test:coverage": "jest --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"jest": "^30.5.2"
	},
	"jest": {
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^buttons$": "<rootDir>/test/mocks/buttons.js"
		},
		"collectCoverageFrom": [
			"flic_hub_module/**/*.js"
		],
		"coverageThreshold": {
			"global": {
				"lines": 100,
				"branches": 100,
				"functions": 100,
				"statements": 100
			}
		}
	}
}
